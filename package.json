{
  "name": "wac",
  "version": "0.1.0",
  "description": "WhatsApp → opencode bridge",
  "private": true,
  "type": "module",
  "bin": {
    "wac": "./wac",
    "wac-start": "./bin/wac-start"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx wac serve",
    "serve": "node wac serve",
    "typecheck": "tsc --noEmit",
    "launchd": "node scripts/install-launchd.mjs",
    "postinstall": "node tools/patch-libsignal.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opencode/client": "^2.0.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "link-preview-js": "^3.2.0",
    "qrcode-terminal": "^0.12.0",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
